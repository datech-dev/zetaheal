# ==============================================================================
# Zeta Heal (OT Pathway) - Environment Configuration Template
# ==============================================================================

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Zeta Heal"

# Supabase Public Configuration (Safe for client browsers and mobile app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Server-Only Secret (Never expose in browser or mobile bundles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Database Direct Connection (For migrations and testing scripts)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Storage Configuration
NEXT_PUBLIC_STORAGE_BUCKET_REPORTS=clinical-reports
NEXT_PUBLIC_STORAGE_BUCKET_MEDIA=activity-media

# Optional Notification Provider (FCM / APNs)
NOTIFICATION_PROVIDER=console # 'console', 'expo', or 'fcm'

# Node Environment
NODE_ENV=development
